{
  "_comment": "命令白名单：只允许发送在本机 GCUService 逆向字符串中确认存在的 Action。查不到的一律不发，避免把没验证过的命令打进 EC。",
  "topics": {
    "fan_control": "Fan/Control",
    "setting_control": "Setting/Control",
    "display_control": "Display/Control",
    "keyboard_ctrl": "Keyboard/Ctrl",
    "lightbar_control": "MyRgbLightbar/Control",
    "battery_control": "BatteryProtection/Control"
  },
  "actions": {
