    "OPERATING_TURBO_MODE": {"topic": "fan_control", "cap": "mode.write", "label": "狂暴档"},
    "FAN_BOOST_ON": {"topic": "fan_control", "cap": "fan.boost", "label": "风扇强开"},
    "FAN_BOOST_OFF": {"topic": "fan_control", "cap": "fan.boost", "label": "风扇强开关掉"},
    "GETSTATUS": {"topic": "setting_control", "cap": "status.read", "label": "拉取设备状态"},
    "WINKEY_LOCK": {"topic": "setting_control", "cap": "winkey", "label": "锁定 Win 键"},
    "WINKEY_UNLOCK": {"topic": "setting_control", "cap": "winkey", "label": "解锁 Win 键"},
    "OSD_HIDDEN_ON": {"topic": "setting_control", "cap": "osd", "label": "隐藏 OSD"},
